# Firebase web configuration.
#
# OPTIONAL. `lib/firebaseConfig.ts` already carries these public identifiers,
# so the site boots with no .env file at all. Set them here only when you want
# a build to point at a different Firebase project than the checked-in one
# (e.g. a staging project for a preview deploy).
#
# These are NOT secrets. They are compiled into the browser bundle by design;
# the actual access control is Firebase Auth plus firestore.rules and
# storage.rules. Never put a service-account key or admin credential here.
#
# NEXT_PUBLIC_* values are inlined at BUILD time, so changing them requires a
# rebuild, not just a restart.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# OPTIONAL extras on top of CANONICAL_ADMIN_EMAILS in lib/access.ts.
# Comma-separated mail IDs granted access to /admin. The canonical list is
# already merged in, so this is only needed for a one-off account.
# NOTE: the UI list alone grants no data access — the same address must also
# be in isAdmin() in firestore.rules AND storage.rules, then deployed.
# Example: organiser1@crescent.education,organiser2@crescent.education
NEXT_PUBLIC_ADMIN_EMAILS=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_SERVICE_ROLE_KEY=

