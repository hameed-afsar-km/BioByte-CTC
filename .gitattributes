# Normalize line endings so Windows checkouts stop rewriting every file.
* text=auto eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.mp4 binary
*.woff binary
*.woff2 binary

# Lockfiles and generated build info: keep diffs out of review
package-lock.json -diff
*.tsbuildinfo linguist-generated=true
