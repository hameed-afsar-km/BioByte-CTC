rules_version = '2';

/**
 * BioByte registration security rules.
 *
 * The browser-side checks in lib/access.ts are only a convenience — these
 * rules are the real boundary. They enforce, server-side:
 *
 *   1. only verified, allow-listed accounts may register;
 *   2. a registration is bound to the account that created it, and the track
 *      must be one of the five published files;
 *   3. only organisers can list every registration, retag a status, or delete
 *      a row.
 *
 * Tracks have no seat limit, so there is no counter to protect and no capacity
 * for a client to tamper with. Any leftover `trackSlots` documents from before
 * that change are unreachable: the catch-all below denies them.
 *
 * Deploy with:  firebase deploy --only firestore:rules
 */
service cloud.firestore {
  match /databases/{database}/documents {

    /* ------------------------------------------------------------------ *
     * Helpers
     * ------------------------------------------------------------------ */

    function signedIn() {
      return request.auth != null;
    }

    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    /* The account's own address, always lower-cased. */
    function authEmail() {
      return request.auth.token.email.lower();
    }

    function onAllowList() {
      return verified() && (
        authEmail().matches('.*@crescent\\.education') ||
        authEmail().matches('.*@crescenttechnocrats\\.club')
      );
    }

    function isAdmin() {
      return signedIn() && (
        authEmail() in [
          '250151601005@crescent.education',
          '240151601011@crescent.education',
          '250151601072@crescent.education',
          '240071601264@crescent.education',
          '240071601263@crescent.education'
        ]
      );
    }

    /* The five published tracks. Hard-coded on purpose: the rules are the
       last line of defence and must not depend on anything a client sends. */
    function isKnownTrack(trackId) {
      return trackId in ['OM-01', 'OM-02', 'OM-03', 'OM-04', 'OM-05'];
    }

    /* ------------------------------------------------------------------ *
     * registrations — one document per email address
     * ------------------------------------------------------------------ */

    match /registrations/{registrationId} {

      function owner() {
        return signedIn() && resource != null && resource.data.uid == request.auth.uid;
      }

      function isSelf() {
        return signedIn() && resource.data.emailId == authEmail();
      }

      function validMember(member) {
        return member.keys().hasOnly([
            'name', 'registrationNo', 'year', 'semester', 'course', 'email',
            'phone', 'address', 'dob'
          ])
          && member.name is string
          && member.name.size() >= 2
          && member.name.size() <= 80
          && member.registrationNo is string
          && member.registrationNo.size() >= 2
          && member.registrationNo.size() <= 50
          && member.year in ['1', '2', '3', '4']
          && member.semester is string
          && member.semester.size() >= 1
          && member.semester.size() <= 20
          && member.course is string
          && member.course.size() >= 2
          && member.course.size() <= 100
          && member.email is string
          && member.email.matches('.*@crescent\\.education')
          && member.phone is string
          && member.phone.size() >= 10
          && member.phone.size() <= 20
          && member.address is string
          && member.address.size() >= 5
          && member.address.size() <= 500
          && member.dob is string
          && member.dob.size() >= 2
          && member.dob.size() <= 30;
      }

      /* A create is only allowed when the payload matches the session:
         no forged uid, no borrowed pass id, no pre-approved status. */
      function validCreate() {
        return onAllowList()
          && request.resource.data.keys().hasOnly([
               'id', 'passId', 'uid', 'teamName', 'collegeName', 'teamSize',
               'members', 'emailId', 'problemId', 'problemTitle', 'alien',
               'hue', 'abstract', 'pptUrl', 'pptPath', 'pptName', 'round',
               'status', 'createdAt'
             ])
          && isKnownTrack(request.resource.data.problemId)
          && request.resource.data.id == registrationId
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.emailId == authEmail()
          && request.resource.data.status == 'registered'
          && request.resource.data.round == 'round-1'
          && request.resource.data.passId is string
          && request.resource.data.passId.matches('^OMNI-[A-Z2-9]{4}-[A-Z2-9]{4}$')
          && request.resource.data.teamName is string
          && request.resource.data.teamName.size() >= 3
          && request.resource.data.teamName.size() <= 60
          && request.resource.data.collegeName is string
          && request.resource.data.collegeName.size() >= 2
          && request.resource.data.collegeName.size() <= 120
          && request.resource.data.abstract is string
          && request.resource.data.abstract.size() <= 1200
          && request.resource.data.members is list
          && request.resource.data.members.size() >= 1
          && request.resource.data.members.size() <= 6
          && (request.resource.data.members.size() < 1 || validMember(request.resource.data.members[0]))
          && (request.resource.data.members.size() < 2 || validMember(request.resource.data.members[1]))
          && (request.resource.data.members.size() < 3 || validMember(request.resource.data.members[2]))
          && (request.resource.data.members.size() < 4 || validMember(request.resource.data.members[3]))
          && (request.resource.data.members.size() < 5 || validMember(request.resource.data.members[4]))
          && (request.resource.data.members.size() < 6 || validMember(request.resource.data.members[5]))
          && request.resource.data.teamSize == request.resource.data.members.size()
          && request.resource.data.createdAt == request.time;
      }

      /* An organiser may retag the status, but must not touch identity or the
         creation stamp. */
      function validAdminUpdate() {
        return isAdmin()
          && request.resource.data.diff(resource.data)
               .affectedKeys()
               .hasOnly(['status', 'statusReason', 'updatedAt']);
      }

      allow get: if (resource == null && signedIn()) || owner() || isAdmin();
      allow list: if isAdmin();
      allow create: if validCreate();
      allow update: if validAdminUpdate();
      allow delete: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin() 
        && request.resource.data.keys().hasAll(['action', 'teamName', 'reason', 'adminEmail', 'timestamp']);
      allow update, delete: if false;
    }

    /* Everything else in this database is closed. */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
